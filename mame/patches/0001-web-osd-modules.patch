diff --git a/src/osd/modules/web/web_input.cpp b/src/osd/modules/web/web_input.cpp
new file mode 100644
index 00000000..4dabbb17
--- /dev/null
+++ b/src/osd/modules/web/web_input.cpp
@@ -0,0 +1,152 @@
+// license:BSD-3-Clause
+// copyright-holders:Arcade Runtime contributors
+
+#include "emu.h"
+
+#include <stdio.h>
+
+#if defined(SDLMAME_EMSCRIPTEN)
+
+enum
+{
+	WEB_CONTROL_UP = 0,
+	WEB_CONTROL_DOWN,
+	WEB_CONTROL_LEFT,
+	WEB_CONTROL_RIGHT,
+	WEB_CONTROL_BUTTON1,
+	WEB_CONTROL_BUTTON2,
+	WEB_CONTROL_BUTTON3,
+	WEB_CONTROL_BUTTON4,
+	WEB_CONTROL_BUTTON5,
+	WEB_CONTROL_BUTTON6,
+	WEB_CONTROL_COIN,
+	WEB_CONTROL_START,
+	WEB_CONTROL_SELECT,
+	WEB_CONTROL_SERVICE,
+	WEB_CONTROL_TEST,
+	WEB_CONTROL_TILT,
+	WEB_CONTROL_STICK2_UP,
+	WEB_CONTROL_STICK2_DOWN,
+	WEB_CONTROL_STICK2_LEFT,
+	WEB_CONTROL_STICK2_RIGHT,
+	WEB_CONTROL_STICK1_UP,
+	WEB_CONTROL_STICK1_DOWN,
+	WEB_CONTROL_STICK1_LEFT,
+	WEB_CONTROL_STICK1_RIGHT,
+	WEB_CONTROL_PEDAL1,
+	WEB_CONTROL_PEDAL2,
+	WEB_CONTROL_PEDAL3,
+	WEB_CONTROL_COUNT
+};
+
+enum
+{
+	WEB_AXIS_X = 0,
+	WEB_AXIS_Y,
+	WEB_AXIS_Z,
+	WEB_AXIS_RX,
+	WEB_AXIS_RY,
+	WEB_AXIS_RELATIVE_X,
+	WEB_AXIS_RELATIVE_Y,
+	WEB_AXIS_COUNT
+};
+
+const int WEB_ABSOLUTE_AXIS_COUNT = 5;
+
+static INT32 s_controls[4][WEB_CONTROL_COUNT];
+static INT32 s_axes[4][WEB_AXIS_COUNT];
+
+static INT32 web_control_state(void *device_internal, void *item_internal)
+{
+	return *reinterpret_cast<INT32 *>(item_internal);
+}
+
+static INT32 web_absolute_axis_state(void *device_internal, void *item_internal)
+{
+	return *reinterpret_cast<INT32 *>(item_internal);
+}
+
+static INT32 web_relative_axis_state(void *device_internal, void *item_internal)
+{
+	INT32 *state = reinterpret_cast<INT32 *>(item_internal);
+	INT32 value = *state;
+	*state = 0;
+	return value;
+}
+
+void web_input_init(running_machine &machine)
+{
+	static const char *const item_names[WEB_CONTROL_COUNT] =
+	{
+		"Up", "Down", "Left", "Right",
+		"Button 1", "Button 2", "Button 3", "Button 4", "Button 5", "Button 6",
+		"Coin", "Start", "Select", "Service", "Test", "Tilt",
+		"Stick 2 Up", "Stick 2 Down", "Stick 2 Left", "Stick 2 Right",
+		"Stick 1 Up", "Stick 1 Down", "Stick 1 Left", "Stick 1 Right",
+		"Pedal 1", "Pedal 2", "Pedal 3"
+	};
+	static const input_item_id item_ids[WEB_CONTROL_COUNT] =
+	{
+		ITEM_ID_HAT1UP, ITEM_ID_HAT1DOWN, ITEM_ID_HAT1LEFT, ITEM_ID_HAT1RIGHT,
+		ITEM_ID_BUTTON1, ITEM_ID_BUTTON2, ITEM_ID_BUTTON3, ITEM_ID_BUTTON4,
+		ITEM_ID_BUTTON5, ITEM_ID_BUTTON6, ITEM_ID_BUTTON7, ITEM_ID_BUTTON8,
+		ITEM_ID_BUTTON9, ITEM_ID_BUTTON10, ITEM_ID_BUTTON11, ITEM_ID_BUTTON12,
+		ITEM_ID_HAT2UP, ITEM_ID_HAT2DOWN, ITEM_ID_HAT2LEFT, ITEM_ID_HAT2RIGHT,
+		ITEM_ID_HAT3UP, ITEM_ID_HAT3DOWN, ITEM_ID_HAT3LEFT, ITEM_ID_HAT3RIGHT,
+		ITEM_ID_BUTTON13, ITEM_ID_BUTTON14, ITEM_ID_BUTTON15
+	};
+	static const char *const axis_names[WEB_AXIS_COUNT] =
+	{
+		"X Axis", "Y Axis", "Z Axis", "RX Axis", "RY Axis", "Relative X", "Relative Y"
+	};
+	static const input_item_id axis_ids[WEB_AXIS_COUNT] =
+	{
+		ITEM_ID_XAXIS, ITEM_ID_YAXIS, ITEM_ID_ZAXIS, ITEM_ID_RXAXIS, ITEM_ID_RYAXIS,
+		ITEM_ID_ADD_RELATIVE1, ITEM_ID_ADD_RELATIVE2
+	};
+
+	memset(s_controls, 0, sizeof(s_controls));
+	memset(s_axes, 0, sizeof(s_axes));
+	for (int pad = 0; pad < 4; pad++)
+	{
+		char name[16];
+		sprintf(name, "Web Pad %d", pad + 1);
+		input_device *device = machine.input().device_class(DEVICE_CLASS_JOYSTICK).add_device(name, &s_controls[pad][0]);
+		for (int item = 0; item < WEB_CONTROL_COUNT; item++)
+			device->add_item(item_names[item], item_ids[item], web_control_state, &s_controls[pad][item]);
+		for (int axis = 0; axis < WEB_AXIS_COUNT; axis++)
+			device->add_item(axis_names[axis], axis_ids[axis],
+				axis < WEB_ABSOLUTE_AXIS_COUNT ? web_absolute_axis_state : web_relative_axis_state,
+				&s_axes[pad][axis]);
+	}
+}
+
+void web_input_exit()
+{
+	memset(s_controls, 0, sizeof(s_controls));
+	memset(s_axes, 0, sizeof(s_axes));
+}
+
+void web_input_set_control(int pad, int item, int pressed)
+{
+	if (pad >= 0 && pad < 4 && item >= 0 && item < WEB_CONTROL_COUNT)
+		s_controls[pad][item] = pressed ? 0x80 : 0;
+}
+
+void web_input_set_axis(int pad, int axis, float value)
+{
+	if (pad < 0 || pad >= 4 || axis < 0 || axis >= WEB_AXIS_COUNT)
+		return;
+	if (axis < WEB_ABSOLUTE_AXIS_COUNT)
+	{
+		if (value < -1.0f)
+			value = -1.0f;
+		else if (value > 1.0f)
+			value = 1.0f;
+		s_axes[pad][axis] = INT32(value * INPUT_ABSOLUTE_MAX);
+	}
+	else
+		s_axes[pad][axis] += INT32(value * INPUT_RELATIVE_PER_PIXEL);
+}
+
+#endif
diff --git a/src/osd/modules/web/web_sound.cpp b/src/osd/modules/web/web_sound.cpp
new file mode 100644
index 00000000..c9dcd875
--- /dev/null
+++ b/src/osd/modules/web/web_sound.cpp
@@ -0,0 +1,43 @@
+// license:BSD-3-Clause
+// copyright-holders:Arcade Runtime contributors
+
+#include "modules/sound/sound_module.h"
+#include "modules/osdmodule.h"
+
+#include <vector>
+
+#if defined(SDLMAME_EMSCRIPTEN)
+
+extern void web_bridge_sound(const float *samples, int frames);
+
+class sound_web : public osd_module, public sound_module
+{
+public:
+	sound_web() : osd_module(OSD_SOUND_PROVIDER, "web"), sound_module() { }
+	virtual ~sound_web() { }
+
+	virtual int init(const osd_options &options) { return 0; }
+	virtual void exit() { m_samples.clear(); }
+
+	virtual void update_audio_stream(bool is_throttled, const INT16 *buffer, int samples_this_frame)
+	{
+		m_samples.resize(samples_this_frame * 2);
+		for (int index = 0; index < samples_this_frame * 2; index++)
+			m_samples[index] = float(buffer[index]) / 32768.0f;
+		if (!m_samples.empty())
+			web_bridge_sound(&m_samples[0], samples_this_frame);
+	}
+
+	virtual void set_mastervolume(int attenuation) { }
+
+private:
+	std::vector<float> m_samples;
+};
+
+#else
+
+	MODULE_NOT_SUPPORTED(sound_web, OSD_SOUND_PROVIDER, "web")
+
+#endif
+
+MODULE_DEFINITION(SOUND_WEB, sound_web)
diff --git a/src/osd/modules/web/web_video.cpp b/src/osd/modules/web/web_video.cpp
new file mode 100644
index 00000000..d17e7d73
--- /dev/null
+++ b/src/osd/modules/web/web_video.cpp
@@ -0,0 +1,112 @@
+// license:BSD-3-Clause
+// copyright-holders:Arcade Runtime contributors
+
+#include "emu.h"
+#include "rendersw.inc"
+
+#include <vector>
+
+#if defined(SDLMAME_EMSCRIPTEN)
+
+extern void web_bridge_frame(const UINT8 *pixels, int width, int height);
+
+typedef software_renderer<UINT32, 0,0,0, 16,8,0, false, false> web_renderer;
+
+static running_machine *s_machine;
+static render_target *s_live_target;
+static bitmap_rgb32 s_bitmap;
+static std::vector<UINT8> s_rgba;
+static int s_width;
+static int s_height;
+static bool s_render_pending;
+static bool s_live_target_ready;
+
+bool web_video_init(running_machine &machine)
+{
+	s_machine = &machine;
+	s_live_target = machine.render().target_alloc();
+	s_live_target_ready = false;
+	s_width = 0;
+	s_height = 0;
+	s_render_pending = false;
+	return true;
+}
+
+void web_video_update(bool skip_redraw)
+{
+	if (!skip_redraw)
+		s_render_pending = true;
+}
+
+void web_video_render()
+{
+	if (s_machine == NULL)
+		return;
+	s_render_pending = false;
+	screen_device *screen = s_machine->first_screen();
+	if (screen == NULL)
+		return;
+	if (!s_live_target_ready)
+	{
+		s_live_target->set_view(s_live_target->configured_view("auto", 0, 1));
+		s_live_target_ready = true;
+	}
+	INT32 width;
+	INT32 height;
+	s_live_target->compute_minimum_size(width, height);
+	if (width != s_width || height != s_height)
+	{
+		s_width = width;
+		s_height = height;
+		s_live_target->set_bounds(width, height);
+		s_bitmap.allocate(width, height);
+		s_rgba.resize(width * height * 4);
+	}
+
+	render_primitive_list &primlist = s_live_target->get_primitives();
+	primlist.acquire_lock();
+	web_renderer::draw_primitives(primlist, &s_bitmap.pix32(0), s_width, s_height, s_bitmap.rowpixels());
+	primlist.release_lock();
+
+	for (int y = 0; y < s_height; y++)
+	{
+		const UINT32 *source = &s_bitmap.pix32(y);
+		UINT8 *destination = &s_rgba[y * s_width * 4];
+		for (int x = 0; x < s_width; x++)
+		{
+			UINT32 pixel = source[x];
+			destination[x * 4 + 0] = (pixel >> 16) & 0xff;
+			destination[x * 4 + 1] = (pixel >> 8) & 0xff;
+			destination[x * 4 + 2] = pixel & 0xff;
+			destination[x * 4 + 3] = 0xff;
+		}
+	}
+
+	web_bridge_frame(&s_rgba[0], s_width, s_height);
+}
+
+void web_video_exit()
+{
+	if (s_machine != NULL && s_live_target != NULL)
+		s_machine->render().target_free(s_live_target);
+	s_machine = NULL;
+	s_live_target = NULL;
+	s_live_target_ready = false;
+	s_bitmap.reset();
+	s_width = 0;
+	s_height = 0;
+	s_render_pending = false;
+	s_rgba.clear();
+}
+
+int web_video_width()
+{
+	return s_width;
+}
+
+int web_video_height()
+{
+	return s_height;
+}
+
+#endif

+//-------------------------------------------------
+//  probe_parity_frame - capture a deterministic
+//  cross-platform checkpoint and input transition
+//-------------------------------------------------
+
+void video_manager::probe_parity_frame(screen_device *screen, UINT64 frame_number)
+{
+	const UINT64 capture_frame = 180;
+	ioport_field *right = NULL;
+	for (ioport_port *port = machine().ioport().first_port(); port != NULL && right == NULL; port = port->next())
+		for (ioport_field *field = port->first_field(); field != NULL; field = field->next())
+			if (field->type() == IPT_JOYSTICK_RIGHT && field->player() == 0)
+			{
+				right = field;
+				break;
+			}
+
+	if (frame_number == capture_frame)
+	{
+		create_snapshot_bitmap(screen);
+		UINT32 width = m_snap_bitmap.width();
+		UINT32 height = m_snap_bitmap.height();
+		UINT32 checksum = 2166136261U;
+		UINT32 non_black_pixels = 0;
+		for (UINT32 y = 0; y < height; y++)
+		{
+			const UINT32 *source = &m_snap_bitmap.pix32(y);
+			for (UINT32 x = 0; x < width; x++)
+			{
+				UINT32 pixel = source[x];
+				UINT8 red = (pixel >> 16) & 0xff;
+				UINT8 green = (pixel >> 8) & 0xff;
+				UINT8 blue = pixel & 0xff;
+				if ((red | green | blue) != 0)
+					non_black_pixels++;
+				checksum = (checksum ^ red) * 16777619U;
+				checksum = (checksum ^ green) * 16777619U;
+				checksum = (checksum ^ blue) * 16777619U;
+				checksum = (checksum ^ 0xff) * 16777619U;
+			}
+		}
+
+		const rectangle &visible = screen->visible_area();
+		int refresh_millihertz = int(1000.0
+			* ATTOSECONDS_TO_HZ(screen->frame_period().attoseconds) + 0.5);
+		m_probe_input_found = right != NULL;
+		m_probe_input_initial = machine().ioport().type_pressed(IPT_JOYSTICK_RIGHT, 0);
+		if (right != NULL)
+			right->set_value(1);
+
+#if defined(EMSCRIPTEN)
+		EM_ASM_ARGS({
+			if (typeof JSMESS === "undefined") return;
+			var parity = {};
+			parity.machine = UTF8ToString($0);
+			parity.frame = $1 >>> 0;
+			parity.width = $2 >>> 0;
+			parity.height = $3 >>> 0;
+			parity.visibleWidth = $4 >>> 0;
+			parity.visibleHeight = $5 >>> 0;
+			parity.refreshMilliHz = $6 >>> 0;
+			parity.checksum = ("00000000" + ($7 >>> 0).toString(16)).slice(-8);
+			parity.nonBlackPixels = $8 >>> 0;
+			JSMESS.parityFrame = parity;
+		}, machine().system().name, UINT32(frame_number), width, height,
+			visible.width(), visible.height(), refresh_millihertz, checksum,
+			non_black_pixels);
+#else
+		osd_printf_info("P12_FRAME machine=%s frame=%u width=%u height=%u visible=%ux%u refresh_millihz=%d checksum=%08x nonblack=%u\n",
+			machine().system().name, UINT32(frame_number), width, height,
+			visible.width(), visible.height(), refresh_millihertz, checksum,
+			non_black_pixels);
+#endif
+	}
+	else if (frame_number == capture_frame + 1)
+	{
+		m_probe_input_pressed = right != NULL
+			&& (right->port().read() & right->mask())
+				!= (right->defvalue() & right->mask());
+		if (right != NULL)
+			right->set_value(0);
+	}
+	else if (frame_number == capture_frame + 2)
+	{
+		bool released = right == NULL
+			|| (right->port().read() & right->mask())
+				== (right->defvalue() & right->mask());
+#if defined(EMSCRIPTEN)
+		EM_ASM_ARGS({
+			if (typeof JSMESS === "undefined") return;
+			var input = {};
+			input.found = $0 !== 0;
+			input.initiallyReleased = $1 === 0;
+			input.pressed = $2 !== 0;
+			input.released = $3 !== 0;
+			JSMESS.parityInput = input;
+		}, m_probe_input_found, m_probe_input_initial,
+			m_probe_input_pressed, released);
+#else
+		osd_printf_info("P12_INPUT found=%d initially_released=%d pressed=%d released=%d\n",
+			m_probe_input_found, !m_probe_input_initial,
+			m_probe_input_pressed, released);
+#endif
+	}
+}
+

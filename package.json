{
  "name": "mame-game-runtime-ts",
  "version": "0.0.0",
  "description": "Run MAME arcade games in the browser through a headless TypeScript runtime",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "manifests/shell"
  ],
  "scripts": {
    "check": "run-s check:src check:tests",
    "check:src": "tsc --noEmit",
    "check:tests": "tsc -p tsconfig.tests.json",
    "clean": "node scripts/clean-dist.mjs",
    "compile": "tsc",
    "compile:package": "tsc -p tsconfig.package.json",
    "build": "run-s clean compile",
    "build:package": "run-s clean compile:package",
    "test": "node --import tsx tests/run.ts spec",
    "test:spec": "node --import tsx tests/run.ts spec",
    "test:browser": "node --import tsx tests/run.ts browser",
    "test:all": "node --import tsx tests/run.ts spec browser"
  },
  "author": "mastergray",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastergray/mame-game-runtime-ts.git"
  },
  "homepage": "https://github.com/mastergray/mame-game-runtime-ts#readme",
  "bugs": "https://github.com/mastergray/mame-game-runtime-ts/issues",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ctg-js-browser-test": "github:claymoretechgroup/ctg-js-browser-test#v2.0.0",
    "ctg-js-test": "github:claymoretechgroup/ctg-js-test#v4.0.0",
    "npm-run-all": "^4.1.5",
    "playwright": "1.62.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.0"
  }
}
